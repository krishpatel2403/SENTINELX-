# SentinelX Environment Configuration
# Copy this file to .env and adjust values. Never commit real secrets.

# Application
APP_NAME=SentinelX
APP_ENV=development
DEBUG=true

# Security (REQUIRED - generate a strong random value for SECRET_KEY)
SECRET_KEY=change-me-to-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./sentinelx.db
# Optional production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://sentinelx:sentinelx@localhost:5432/sentinelx
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinelx

# CORS
CORS_ORIGINS=http://localhost:5173

# Uploads
MAX_UPLOAD_SIZE_MB=50

# Rate limiting (requests per window)
RATE_LIMIT_AUTH=10
RATE_LIMIT_INGESTION=30

# Threat intelligence (optional public feeds - disabled by default)
THREAT_FEED_ENABLED=false
THREAT_FEED_URL=

# Seed default admin (change in production)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_EMAIL=admin@sentinelx.com
